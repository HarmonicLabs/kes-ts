  },
  "homepage": "https://github.com/HarmonicLabs/kes-ts#readme",
  "dependencies": {
    "@harmoniclabs/crypto": "^0.3.1"
  },
  "devDependencies": {
    "@types/bun": "~1.3.14",
    "typescript": "^5.9.3"
  },
  "keywords": [
